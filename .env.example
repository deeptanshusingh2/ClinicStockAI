# ClinicStock AI — VisionStock Configuration

# Host and Port for Backend API
HOST=127.0.0.1
PORT=8000

# Ollama Model and Host (Gemma 4 Vision)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Expiry Risk Threshold (in days, default 90)
EXPIRY_THRESHOLD_DAYS=90

# Upload Limits (Max size in bytes, 8MB per PRD)
MAX_UPLOAD_SIZE_BYTES=8388608
